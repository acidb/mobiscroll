{
  "name": "mobiscroll",
  "version": "6.1.4",
  "description": "Scheduling, event calendar and resource management UI components, and Mobiscroll Connect, the calendar connectivity layer for scheduling products. Index for both; holds the open-source form components and the changelogs.",
  "homepage": "https://mobiscroll.com/",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acidb/mobiscroll.git"
  },
  "bugs": {
    "url": "https://github.com/acidb/mobiscroll/issues"
  },
  "scripts": {
    "build-react": "node ./scripts/build.js react",
    "build-vue": "node ./scripts/build.js vue",
    "build-javascript": "node ./scripts/build.js javascript",
    "build-jquery": "node ./scripts/build.js jquery",
    "build-angular": "node ./scripts/build-angular.js",
    "build-npm": "npm run build-react && npm run build-vue && npm run build-javascript && npm run build-jquery && npm run build-angular",
    "bump-version": "node ./scripts/bump-version.js",
    "publish": "cd ./packages/react && npm publish && cd ../vue && npm publish && cd ../javascript && npm publish && cd ../jquery && npm publish && cd ../angular && npm publish",
    "eslint": "eslint src/**",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@angular/common": "^13.4.0",
    "@angular/compiler": "^13.4.0",
    "@angular/compiler-cli": "^13.4.0",
    "@angular/core": "^13.4.0",
    "@angular/forms": "^13.4.0",
    "@angular/platform-browser": "^13.4.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.22.20",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-terser": "^1.0.0",
    "@vue/babel-plugin-jsx": "^1.1.1",
    "@vue/tsconfig": "^0.1.3",
    "autoprefixer": "^10.4.19",
    "fs-extra": "^8.1.0",
    "postcss": "^8.4.38",
    "remove-empty-directories": "0.0.1",
    "rollup": "^4.18.0",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "1.92.0",
    "scss-bundle": "^3.1.1",
    "typescript": "4.6.4"
  },
  "dependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.5",
    "jquery": "^3.5.1",
    "preact": "^10.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "^6.5.3",
    "tslib": "^2.6.2",
    "vue": "^3.4.27",
    "zone.js": "~0.11.4"
  },
  "browserslist": [
    "last 1 version",
    "> 1%",
    "Chrome 56",
    "Firefox 32",
    "Safari 13",
    "iOS 13"
  ]
