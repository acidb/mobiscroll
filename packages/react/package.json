{
  "name": "@mobiscroll/react-lite",
  "version": "6.1.4",
  "description": "Open-source React form, notification and popup components from Mobiscroll — the scheduling, event calendar and resource management UI library. Apache-2.0. Scheduler, timeline, agenda and date pickers are commercial.",
  "homepage": "https://mobiscroll.com/docs/react",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mobiscroll",
    "react",
    "ui-components",
    "form-components",
    "forms",
    "input",
    "checkbox",
    "switch",
    "stepper",
    "notifications",
    "toast",
    "snackbar",
    "modal",
    "dialog",
    "popover",
    "bottom-sheet",
    "open-source",
    "popup",
    "accessibility"
  ],
  "author": {
    "name": "Mobiscroll",
    "url": "https://mobiscroll.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acidb/mobiscroll.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/acidb/mobiscroll/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/esm5/mobiscroll.react.min.d.ts",
      "import": "./dist/esm5/mobiscroll.react.min.mjs",
      "require": "./dist/js/mobiscroll.react.min.cjs"
    },
    "./dist/css/*": "./dist/css/*",
    "./dist/src/*": "./dist/src/*"
  },
  "main": "dist/js/mobiscroll.react.min.cjs",
  "module": "dist/esm5/mobiscroll.react.min.mjs",
  "types": "dist/src/react/bundle.d.ts",
  "sideEffects": false,
  "style": "dist/css/mobiscroll.min.css",
  "files": [
    "dist/js/*",
    "dist/esm5/*",
    "dist/css/*",
    "dist/src/**",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
