{
  "name": "@mobiscroll/angular-lite",
  "version": "6.1.3",
  "description": "Open-source Angular form, notification and popup components from Mobiscroll — the scheduling, event calendar and resource management UI library. Apache-2.0. Scheduler, timeline, agenda and date pickers are commercial.",
  "homepage": "https://mobiscroll.com/docs/angular",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mobiscroll",
    "angular",
    "ui-components",
    "form-components",
    "forms",
    "input",
    "checkbox",
    "switch",
    "stepper",
    "notifications",
    "toast",
    "snackbar",
    "modal",
    "dialog",
    "popover",
    "bottom-sheet",
    "open-source",
    "popup",
    "accessibility"
  ],
  "author": {
    "name": "Mobiscroll",
    "url": "https://mobiscroll.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acidb/mobiscroll.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/acidb/mobiscroll/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/esm5/mobiscroll.angular.min.d.ts",
      "import": "./dist/esm5/mobiscroll.angular.min.mjs",
      "require": "./dist/js/mobiscroll.angular.min.cjs"
    },
    "./dist/css/*": "./dist/css/*",
    "./dist/js/*": "./dist/js/*"
  },
  "main": "dist/js/mobiscroll.angular.min.cjs",
  "module": "dist/esm5/mobiscroll.angular.min.mjs",
  "types": "dist/js/mobiscroll.angular.min.d.ts",
  "sideEffects": false,
  "style": "dist/css/mobiscroll.min.css",
  "files": [
    "dist/js/**",
    "dist/esm5/**",
    "dist/css/**",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "peerDependencies": {
    "@angular/core": ">=13.0.0",
    "@angular/common": ">=13.0.0",
    "@angular/forms": ">=13.0.0"
  }
}
