{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "target": "es5",
    "jsx": "react",
    "baseUrl": "./",
    "paths": {
      "@angular/core": ["src/react/base"],
      "@framework/*": ["src/react/*"]
    },
    "typeRoots": ["node_modules/@types"],
    "types": [],
    "lib": ["es2017", "dom"]
  },
  "include": ["src/angular", "src/core"]
}
